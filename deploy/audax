#!/usr/bin/env bash
# Look inside the running agent from this machine (read-only).
#   ./deploy/audax                 today: health, messages, research, decisions, senses, Claude runs
#   ./deploy/audax day 2026-10-10  a specific day
#   ./deploy/audax jobs            what the engine runs next: its jobs, each sense, each mission (+ heartbeat)
#   ./deploy/audax claude          every way Claude is called: prompt, model, tools, trigger, last week's cost
#   ./deploy/audax usage [days]    quota analysis: per day, per kind, cache hits, signs of waste, priciest runs
#   ./deploy/audax runs [kind] [n] Claude runs with tool-call traces (kind: research, chat, dispatcher, director_reflect, ...)
#   ./deploy/audax decisions [n]   dispatcher decisions with reasons
#   ./deploy/audax research        search portfolios
#   ./deploy/audax senses          per-source yield and readability per domain
#   ./deploy/audax errors          recent failures
#   ./deploy/audax logs            follow the service log
#   ./deploy/audax memory          what changed in memory and instance lately (git log)
#   ./deploy/audax night [reflect|replay|<role>] [friend]   run the night sweep now (within ten minutes); reflect: Director
#                                  reflects; replay: last night again from the evening before; <role>: only that role's step
#                                  (assistant, director, researcher, manager); friend: in that friend's instance
#   ./deploy/audax friend <name> "<first name>" [cap $/week]   set up Audax for a friend (asks for their bot's token)
#   ./deploy/audax friends         the friends' instances: running or not, and what each spent this week
#   ./deploy/audax onboarding [host] try the first conversation in the terminal; nothing is kept (host: as a friend on host's machine)
#   ./deploy/audax rollback        undo the engine's latest commit on the Pi (e.g. a build-mode change that broke it) and restart
set -euo pipefail
[ -f "$(dirname "$0")/../.deploy.env" ] && . "$(dirname "$0")/../.deploy.env"
: "${PI_HOST:?Sätt PI_HOST=user@host i .deploy.env}"
DIR="${PI_DIR:-Projekt/audax}"
case "${1:-today}" in
  logs)   exec ssh -t "$PI_HOST" "journalctl -u agent -f -o cat" ;;
  rollback)
    ssh "$PI_HOST" "cd $DIR && echo 'Backar:' && git log -1 --format='  %h %s (%an, %ar)' && git revert --no-edit HEAD >/dev/null && ~/.local/bin/uv sync --no-dev -q && sudo systemctl restart agent && sleep 8 && systemctl is-active agent && git log -1 --format='Nu: %h %s'"
    echo "Kör ./deploy/deploy.sh (eller git pull pi main) så att Macen får återställningen." ;;
  night)
    extra="" force="true" db="$DIR/data/agent.db"
    [ -n "${3:-}" ] && db="audax-friends/$3/data/agent.db"
    case "${2:-}" in
      reflect) extra="INSERT OR REPLACE INTO kv (key, value) VALUES ('night.force_reflect', 'true');" ;;
      replay) force='\"replay\"'; extra="INSERT OR REPLACE INTO kv (key, value) VALUES ('night.force_reflect', 'true');" ;;
      assistant|director|researcher|manager) force="\\\"$2\\\"" ;;
    esac
    ssh "$PI_HOST" "sqlite3 $db \"INSERT OR REPLACE INTO kv (key, value) VALUES ('night.force', '$force'); $extra\""
    echo "Nattsvepet startar inom tio minuter. Följ det med ./deploy/audax logs, eller på kontorssidan." ;;
  onboarding) shift; exec ssh -t "$PI_HOST" "cd $DIR && ~/.local/bin/uv run --no-dev python -m agent.try_onboarding $(printf '%q ' "$@")" ;;
  friend) shift; exec ssh -t "$PI_HOST" "cd $DIR && ./deploy/add-friend.sh $(printf '%q ' "$@")" ;;
  friends)
    exec ssh "$PI_HOST" 'for d in ~/audax-friends/*/; do n=$(basename "$d"); s=$(systemctl is-active "agent@$n"); w=$(sqlite3 "$d/data/agent.db" "SELECT round(coalesce(sum(cost_usd),0),2) FROM claude_runs WHERE created_at >= datetime(\"now\",\"-7 days\")" 2>/dev/null || echo "?"); echo "$n: $s, $w \$ senaste 7 dagarna"; done' ;;
  memory) exec ssh "$PI_HOST" "cd $DIR && echo '== minne' && git -C workspace/memory log --since='3 days ago' --format='%ad %s' --date=format:'%d/%m %H:%M' | head -25 && echo && echo '== instans' && git -C instance log --since='7 days ago' --format='%ad %s' --date=format:'%d/%m %H:%M' | head -15" ;;
  *)      exec ssh "$PI_HOST" "cd $DIR && .venv/bin/python -m agent.inspect $*" ;;
esac
