<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>audax.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>"__HOME__/__REPO_FROM_HOME__/deploy/backup.sh"</string></array>
  <!-- Daily at 12:00; if the Mac was asleep, launchd runs it once on wake. -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Backups/audax/backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Backups/audax/backup.log</string>
</dict>
</plist>
