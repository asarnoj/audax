# Telegram: skapa en bot via @BotFather och klistra in token här.
TELEGRAM_TOKEN=

# Ditt chat-id. Lämna tomt första gången: skriv /start till boten så svarar den med id:t.
TELEGRAM_CHAT_ID=

# OBS: sätt ALDRIG ANTHROPIC_API_KEY här. Agenten kör bara via din Claude-prenumeration
# (Claude Code-inloggningen) och vägrar starta om en API-nyckel finns i miljön.

# Kalendrar (M2)
# TimeEdit: "Prenumerera"/"Exportera" i TimeEdit → kopiera ICS-länken.
TIMEEDIT_ICS_URL=
# Apple/iCloud via CalDAV. Skapa ett appspecifikt lösenord på https://account.apple.com
# (Inloggning och säkerhet → Appspecifika lösenord). Lägg in det själv, dela det inte.
APPLE_ID=
APPLE_APP_PASSWORD=
# Valfritt: vilka iCloud-kalendrar som ska läsas, kommaseparerat (tomt = alla).
APPLE_CALENDARS=

# Fönster (Director). GitHub: användarnamn räcker för publika repon. För privata: skapa en
# fine-grained token med BARA läsrätt (Contents: Read, Metadata: Read) på github.com/settings/tokens.
GITHUB_USER=
GITHUB_TOKEN=
